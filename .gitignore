desktop.ini
Thumbs.db
.DS_Store

# SolidWorks lock files. They appear while a document is open and vanish when it
# closes, so tracking them means every commit shows CAD churn that is not real.
~$*
*.swp
sw2urdf_logs/
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Everything under sim/ is generated: the raw SolidWorks export, and the model
# tools/prepare_model.py builds from it. The source of truth is robot/, which is
# committed. Regenerate, do not edit, and never commit.
# Leading slash on purpose: a bare pattern matches at every depth and last time
# that silently swallowed 48 files somebody meant to keep.
/sim/

# Training output
/logs/
/runs/
/wandb/
*.pt
*.ckpt
*.onnx
MUJOCO_LOG.TXT

# Videos and renders produced by scripts. Overview/ is build photography and stays.
# A run's run.json and metrics.csv ARE committed - they are the record of what was
# tried and what happened. The videos and checkpoints are not.
/progress/**/*.mp4
/progress/**/checkpoints/
/progress/runs/0000-00-00_demo/
/reference/**/*.mp4

# The training queue's live state. progress/queue.json IS committed - it is the
# record of what was planned and in what order, which is worth reading back.
# These three are not:
#   runner.json  a heartbeat, rewritten every couple of seconds
#   queue.lock   exists only while a write is in flight
#   jobs/        the runner's captured stdout, hundreds of MB over a long night
/progress/runner.json
/progress/queue.lock
/progress/queue.json.tmp
/progress/jobs/

# Claude Code ships a pile of generic plugin skills into .claude/skills.
# They are tooling, not this project, and they change whenever a plugin
# updates. The two that ARE the project are force-added: settings.json, and
# ste/, which CLAUDE.md requires be loaded at the start of every session.
/.claude/skills/*
!/.claude/skills/ste/
